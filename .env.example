# Copied to .env (gitignored) for local docker-compose values.
# Keep POSTGRES_USER/POSTGRES_PASSWORD in sync with api/phpunit.xml's pgsql
# defaults if you change them (phpunit deliberately targets its own
# `inflection_test` database on this same server, seeded by
# docker/postgres/init-test-db.sql, so dev and test data never mix).

POSTGRES_DB=inflection
POSTGRES_USER=inflection
POSTGRES_PASSWORD=inflection
POSTGRES_PORT=5432

REDIS_PORT=6379

APP_PORT=8000
